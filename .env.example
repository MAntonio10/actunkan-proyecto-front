# ============================================================================
#  Parque Actun Kan - frontend. Plantilla de variables de entorno.
#
#  Copie este archivo como `.env.local` (desarrollo) o defina estas variables en
#  el entorno donde corra `npm run build` (produccion).
#
#  IMPORTANTE: las variables NEXT_PUBLIC_* se incrustan en el paquete al
#  COMPILAR, no se leen al arrancar. Si cambia el dominio del backend hay que
#  volver a compilar; reiniciar el servidor no basta.
# ============================================================================

# Direccion publica del backend, la que usa el navegador del visitante.
# Tiene que coincidir con API_URL del backend y estar incluida en su CORS.
# Sin barra al final.
NEXT_PUBLIC_API_URL=https://api.sudominio.com

# Puerto e interfaz en los que sirve Next. Detras de un proxy inverso no son los
# que ve el publico.
PORT=3000
HOSTNAME=0.0.0.0
